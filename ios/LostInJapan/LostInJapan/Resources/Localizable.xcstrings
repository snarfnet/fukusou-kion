            "value": "หากเกิดการโจรกรรมได้ให้อธิบายสถานการณ์ให้ตำรวจทราบ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盗難の可能性がある場合は警察に事情を説明してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pencurian mungkin terjadi, jelaskan situasinya kepada polisi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu có thể bị trộm, hãy giải thích tình hình cho cảnh sát."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se for possível o roubo, explique a situação à polícia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è possibile un furto, spiegare la situazione alla polizia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если возможна кража, объясните ситуацию полиции."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت السرقة ممكنة، اشرح الوضع للشرطة."
          }
        }
      }
    },
    "found.guidanceOnly": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This is guidance only. The app does not contact, match, or exchange messages with other users." } },
        "ja": { "stringUnit": { "state": "translated", "value": "この画面は案内専用です。他のユーザーとの連絡、照合、メッセージ交換は行いません。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此页面仅提供指南。本应用不会联系、匹配其他用户或与其交换消息。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此頁面僅提供指南。本App不會聯絡、配對其他使用者或與其交換訊息。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 화면은 안내 전용입니다. 다른 사용자와 연락하거나 연결하거나 메시지를 주고받지 않습니다." } },
        "es": { "stringUnit": { "state": "translated", "value": "Esta sección es solo informativa. La app no contacta, conecta ni intercambia mensajes con otros usuarios." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Cette section est uniquement informative. L’app ne permet ni contact, ni mise en relation, ni échange de messages entre utilisateurs." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dieser Bereich dient nur als Anleitung. Die App stellt keinen Kontakt her und ermöglicht weder Zuordnung noch Nachrichtenaustausch zwischen Nutzern." } },
        "th": { "stringUnit": { "state": "translated", "value": "หน้านี้มีไว้เพื่อให้คำแนะนำเท่านั้น แอปไม่มีการติดต่อ จับคู่ หรือแลกเปลี่ยนข้อความกับผู้ใช้รายอื่น" } },
        "id": { "stringUnit": { "state": "translated", "value": "Bagian ini hanya berisi panduan. Aplikasi tidak menghubungkan, mencocokkan, atau bertukar pesan dengan pengguna lain." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mục này chỉ cung cấp hướng dẫn. Ứng dụng không liên hệ, kết nối hay trao đổi tin nhắn với người dùng khác." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Esta seção é apenas informativa. O app não contata, conecta nem troca mensagens com outros usuários." } },
        "it": { "stringUnit": { "state": "translated", "value": "Questa sezione è solo informativa. L’app non contatta, abbina né scambia messaggi con altri utenti." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Этот раздел содержит только инструкции. Приложение не связывает пользователей и не позволяет обмениваться сообщениями." } },
        "ar": { "stringUnit": { "state": "translated", "value": "هذا القسم للإرشاد فقط. لا يتيح التطبيق التواصل أو المطابقة أو تبادل الرسائل مع مستخدمين آخرين." } }
      }
    },
