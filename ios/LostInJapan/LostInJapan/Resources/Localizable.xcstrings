    "onboarding.title1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost something in Japan?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本で物をなくしましたか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日本丢东西了？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在日本丟東西了？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일본에서 물건을 잃어버렸나요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Perdiste algo en Japón?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez perdu quelque chose au Japon ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas in Japan verloren?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของหายในญี่ปุ่นเหรอ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehilangan sesuatu di Jepang?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mất thứ gì ở Nhật Bản?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdeu algo no Japão?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai perso qualcosa in Giappone?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потеряли что-то в Японии?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقدت شيئا في اليابان؟"
          }
        }
      }
    },
    "onboarding.body1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See who to contact, what to do, and what to say in Japanese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問い合わせ先、行動手順、日本語での説明をすぐに表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看与谁联系、做什么以及用日语说些什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看與誰聯繫、做什麼以及用日語說些什麼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구에게 연락해야 하는지, 무엇을 해야 하는지, 일본어로 무엇을 말해야 하는지 알아보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea a quién contactar, qué hacer y qué decir en japonés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez qui contacter, quoi faire et quoi dire en japonais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahren Sie, an wen Sie sich wenden, was Sie tun und was Sie auf Japanisch sagen können."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าควรติดต่อใคร ทำอะไร และจะพูดอะไรเป็นภาษาญี่ปุ่น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat siapa yang harus dihubungi, apa yang harus dilakukan, dan apa yang harus dikatakan dalam bahasa Jepang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem ai cần liên hệ, phải làm gì và nói gì bằng tiếng Nhật."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quem contatar, o que fazer e o que dizer em japonês."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri chi contattare, cosa fare e cosa dire in giapponese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, к кому обратиться, что делать и что сказать по-японски."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرف على من يجب الاتصال به، وماذا تفعل، وماذا تقول باللغة اليابانية."
          }
        }
      }
    },
    "onboarding.title2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show, don't struggle to explain"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を見せて伝える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展示，无需费力解释"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展示，無需費力解釋"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보여주세요, 설명하려고 애쓰지 마세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra, no te esfuerces en explicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre, ne lutte pas pour expliquer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie es, machen Sie sich keine Mühe, es zu erklären"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงอย่าพยายามอธิบาย"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan, jangan kesulitan menjelaskan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thể hiện, đừng cố gắng giải thích"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre, não se esforce para explicar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra, non faticare a spiegare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите, не пытайтесь объяснить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر، لا تكافح من أجل التوضيح"
          }
        }
      }
    },
    "onboarding.body2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the item and place. We create a Japanese card for staff or police."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物と場所を選ぶだけで、スタッフや警察に見せるカードを作ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择项目和地点。我们为工作人员或警察制作一张日本卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇項目和地點。我們為工作人員或警察製作一張日本卡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 장소를 선택하세요. 직원이나 경찰을 위한 일본어 카드를 만듭니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el artículo y el lugar. Creamos una tarjeta japonesa para el personal o la policía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'article et le lieu. Nous créons une carte japonaise pour le personnel ou la police."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Artikel und platzieren Sie ihn. Wir erstellen eine japanische Karte für Personal oder Polizei."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรายการและสถานที่ เราจัดทำบัตรภาษาญี่ปุ่นสำหรับเจ้าหน้าที่หรือตำรวจ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih item dan tempatnya. Kami membuat kartu Jepang untuk staf atau polisi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn mục và địa điểm. Chúng tôi tạo thẻ tiếng Nhật cho nhân viên hoặc công an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o item e o local. Criamos um cartão japonês para funcionários ou policiais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli l'oggetto e il luogo. Creiamo una carta giapponese per il personale o la polizia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите предмет и место. Создаем японскую карту для сотрудников или полиции."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر العنصر والمكان. نقوم بإنشاء بطاقة يابانية للموظفين أو الشرطة."
          }
        }
      }
    },
    "onboarding.title3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the urgent step"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急ぐ手続きから案内"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从紧急的步骤开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從緊急的步驟開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴급한 조치부터 시작하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience con el paso urgente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par l’étape urgente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit dem dringenden Schritt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มต้นด้วยขั้นตอนเร่งด่วน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah dengan langkah mendesak"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu với bước cấp bách"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com a etapa urgente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con il passaggio urgente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с срочного шага"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بالخطوة العاجلة"
          }
        }
      }
    },
    "onboarding.body3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get focused help for passports, wallets, phones, cards, and medicine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスポート、財布、スマートフォンなどの紛失にも対応します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获得有关护照、钱包、手机、银行卡和药品的重点帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得有關護照、錢包、手機、銀行卡和藥品的重點幫助。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여권, 지갑, 휴대폰, 카드, 의약품에 대한 집중적인 도움을 받아보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenga ayuda específica para pasaportes, billeteras, teléfonos, tarjetas y medicamentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez une aide ciblée pour les passeports, les portefeuilles, les téléphones, les cartes et les médicaments."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie gezielte Hilfe für Pässe, Geldbörsen, Telefone, Karten und Medikamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับความช่วยเหลือเฉพาะเรื่องหนังสือเดินทาง กระเป๋าสตางค์ โทรศัพท์ การ์ด และยารักษาโรค"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan bantuan terfokus untuk paspor, dompet, telepon, kartu, dan obat-obatan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận trợ giúp tập trung về hộ chiếu, ví, điện thoại, thẻ và thuốc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha ajuda focada para passaportes, carteiras, telefones, cartões e remédios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni assistenza mirata per passaporti, portafogli, telefoni, carte e medicinali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите целевую помощь по паспортам, кошелькам, телефонам, картам и лекарствам."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على مساعدة مركزة فيما يتعلق بجوازات السفر والمحافظ والهواتف والبطاقات والأدوية."
          }
        }
      }
    },
