{
  "sourceLanguage": "en",
  "strings": {
    "emergency.callPolice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are in immediate danger, call 110."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "危険が迫っている場合は110番へ電話してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有紧急危险，请拨打110。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如有緊急危險，請撥打110。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 위험한 상황이면 110에 전화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hay peligro inmediato, llama al 110."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas de danger immédiat, appelez le 110."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rufen Sie bei unmittelbarer Gefahr die 110 an."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีอันตรายเร่งด่วน โทร 110"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda berada dalam bahaya, hubungi 110."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đang gặp nguy hiểm ngay lập tức, hãy gọi 110."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você estiver em perigo imediato, ligue para 110."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sei in pericolo immediato, chiama il 110."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вам угрожает непосредственная опасность, позвоните по номеру 110."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت في خطر مباشر، اتصل بالرقم 110."
          }
        }
      }
    },
    "emergency.passport.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact the nearest police box first and get a lost-property report. Then contact your embassy or consulate. Keep a photo of the report number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最寄りの交番で遺失届を出し、受理番号を控えてください。その後、大使館または領事館へ連絡します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先到最近的派出所提交遗失申报并记下受理编号，然后联系使领馆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先到最近的派出所提交遺失申報並記下受理編號，再聯絡使領館。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 파출소에서 분실 신고를 하고 접수 번호를 받은 뒤 대사관이나 영사관에 연락하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presenta una denuncia de pérdida en el puesto de policía más cercano, guarda el número y contacta con tu embajada o consulado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclarez la perte au poste de police le plus proche, notez le numéro, puis contactez votre ambassade ou consulat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie den Verlust beim nächsten Koban, notieren Sie die Vorgangsnummer und kontaktieren Sie Ihre Botschaft oder Ihr Konsulat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งของหายที่ป้อมตำรวจใกล้ที่สุด เก็บเลขรับเรื่อง แล้วติดต่อสถานทูตหรือสถานกงสุล"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungi boks polisi terdekat terlebih dahulu dan dapatkan laporan barang hilang. Kemudian hubungi kedutaan atau konsulat Anda. Simpan foto nomor laporan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên hãy liên hệ với đồn cảnh sát gần nhất và nhận được trình báo về tài sản bị mất. Sau đó liên hệ với đại sứ quán hoặc lãnh sự quán của bạn. Giữ một bức ảnh của số báo cáo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre em contato primeiro com a delegacia de polícia mais próxima e obtenha um relatório de perda de bens. Em seguida, entre em contato com sua embaixada ou consulado. Mantenha uma foto do número do relatório."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contatta prima la cabina di polizia più vicina e ricevi una denuncia di oggetti smarriti. Allora contatta la tua ambasciata o il tuo consolato. Conserva una foto del numero del rapporto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала обратитесь в ближайшую полицейскую будку и получите отчет о пропаже имущества. Затем обратитесь в посольство или консульство. Сохраните фотографию номера отчета."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بأقرب صندوق شرطة أولاً واحصل على تقرير عن الممتلكات المفقودة. ثم اتصل بسفارتك أو قنصليتك. احتفظ بصورة من رقم التقرير."
          }
        }
      }
    },
    "emergency.wallet.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze your bank cards and payment apps. Report the wallet to the police and contact the last place you visited. List the cash, cards and IDs inside."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行カードと決済アプリを停止し、警察へ届けてください。最後に立ち寄った場所にも連絡し、中身を一覧にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即停用银行卡和支付应用，向警方报失，并联系最后到访的地点。列出钱包内的现金、卡片和证件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即停用銀行卡和支付應用程式，向警方報失，並聯絡最後到訪的地點。列出錢包內物品。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행 카드와 결제 앱을 정지하고 경찰에 신고하세요. 마지막 방문 장소에도 연락하고 지갑 안 물품을 정리하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea tarjetas y aplicaciones de pago, denuncia la pérdida y contacta con el último lugar visitado. Haz una lista del contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquez cartes et applications de paiement, signalez la perte et contactez le dernier lieu visité. Listez le contenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren Sie Karten und Bezahl-Apps, melden Sie den Verlust und kontaktieren Sie den zuletzt besuchten Ort. Listen Sie den Inhalt auf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระงับบัตรธนาคารและแอปชำระเงิน แจ้งตำรวจ ติดต่อสถานที่ล่าสุด และทำรายการของในกระเป๋า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekukan kartu bank dan aplikasi pembayaran Anda. Laporkan dompet tersebut ke polisi dan hubungi tempat terakhir yang Anda kunjungi. Cantumkan uang tunai, kartu, dan tanda pengenal di dalamnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng băng thẻ ngân hàng và ứng dụng thanh toán của bạn. Hãy báo cáo chiếc ví cho cảnh sát và liên hệ với nơi bạn ghé thăm lần cuối. Liệt kê tiền mặt, thẻ và ID bên trong."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congele seus cartões bancários e aplicativos de pagamento. Denuncie a carteira à polícia e entre em contato com o último local que visitou. Liste o dinheiro, cartões e identidades dentro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela le tue carte bancarie e le app di pagamento. Denuncia il portafoglio alla polizia e contatta l'ultimo luogo che hai visitato. Elenca i contanti, le carte e i documenti d'identità all'interno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заморозьте свои банковские карты и платежные приложения. Сообщите о кошельке в полицию и обратитесь в последнее место, которое вы посетили. Перечислите наличные, карты и удостоверения личности внутри."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتجميد بطاقاتك المصرفية وتطبيقات الدفع. قم بإبلاغ الشرطة عن المحفظة واتصل بآخر مكان قمت بزيارته. قم بإدراج النقود والبطاقات والهويات بالداخل."
          }
        }
      }
    },
    "emergency.phone.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Find My iPhone or Find My Device, lock the phone and contact your carrier. Do not go alone to an unknown location shown on the map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の探索機能で位置を確認し、遠隔ロックして通信会社へ連絡してください。表示された知らない場所へ一人で向かわないでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设备查找功能定位并远程锁定，然后联系运营商。不要独自前往地图显示的陌生地点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用裝置尋找功能定位並遠端鎖定，再聯絡電訊商。不要獨自前往地圖顯示的陌生地點。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 찾기로 위치를 확인하고 원격 잠금한 뒤 통신사에 연락하세요. 지도에 나온 낯선 장소에는 혼자 가지 마세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Localiza y bloquea el teléfono a distancia y contacta con tu operador. No vayas solo a un lugar desconocido del mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisez et verrouillez le téléphone à distance, puis contactez votre opérateur. N'allez pas seul à un lieu inconnu indiqué sur la carte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orten und sperren Sie das Telefon aus der Ferne und kontaktieren Sie den Mobilfunkanbieter. Gehen Sie nicht allein zu einem unbekannten Kartenort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ระบบค้นหาและล็อกโทรศัพท์จากระยะไกล แล้วติดต่อเครือข่าย อย่าไปยังสถานที่ไม่รู้จักเพียงลำพัง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Temukan iPhone Saya atau Temukan Perangkat Saya, kunci ponsel dan hubungi operator Anda. Jangan pergi sendirian ke lokasi yang tidak diketahui yang ditunjukkan pada peta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng Tìm iPhone của tôi hoặc Tìm thiết bị của tôi, khóa điện thoại và liên hệ với nhà cung cấp dịch vụ của bạn. Đừng đi một mình đến một địa điểm không xác định được hiển thị trên bản đồ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Find My iPhone ou Find My Device, bloqueie o telefone e entre em contato com sua operadora. Não vá sozinho para um local desconhecido mostrado no mapa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza Trova il mio iPhone o Trova il mio dispositivo, blocca il telefono e contatta il tuo operatore. Non andare da solo in una località sconosciuta mostrata sulla mappa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте «Найти iPhone» или «Найти мое устройство», заблокируйте телефон и обратитесь к своему оператору связи. Не отправляйтесь в одиночку в неизвестное место, указанное на карте."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم Find My iPhone أو Find My Device، وقم بقفل الهاتف واتصل بمشغل شبكة الجوال. لا تذهب بمفردك إلى مكان مجهول موضح على الخريطة."
          }
        }
      }
    },
    "emergency.card.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze the card in the issuer's app or call the number on its website. Check recent transactions and report any charge you do not recognize."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード会社のアプリまたは公式窓口で利用停止し、直近の明細を確認してください。身に覚えのない利用はすぐ申告します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过发卡机构应用或官网电话停卡，检查近期交易并立即报告陌生扣款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過發卡機構應用程式或官網電話停卡，檢查近期交易並立即報告不明扣款。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드사 앱이나 공식 번호로 카드를 정지하고 최근 결제를 확인하세요. 모르는 결제는 즉시 신고하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea la tarjeta desde la aplicación o el número oficial. Revisa los movimientos y comunica cualquier cargo desconocido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquez la carte via l'application ou le numéro officiel. Vérifiez les opérations et signalez tout débit inconnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren Sie die Karte über die App oder offizielle Nummer. Prüfen Sie Umsätze und melden Sie unbekannte Abbuchungen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระงับบัตรผ่านแอปหรือเบอร์ทางการ ตรวจสอบรายการล่าสุด และแจ้งรายการที่ไม่รู้จักทันที"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekukan kartu di aplikasi penerbit atau hubungi nomor di situs webnya. Periksa transaksi terkini dan laporkan tagihan apa pun yang tidak Anda kenali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng băng thẻ trong ứng dụng của nhà phát hành hoặc gọi đến số trên trang web của nhà phát hành. Kiểm tra các giao dịch gần đây và báo cáo bất kỳ khoản phí nào bạn không nhận ra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congele o cartão no aplicativo do emissor ou ligue para o número em seu site. Verifique as transações recentes e relate qualquer cobrança que você não reconhece."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca la carta nell'app dell'emittente o chiama il numero sul suo sito web. Controlla le transazioni recenti e segnala eventuali addebiti che non riconosci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заморозьте карту в приложении эмитента или позвоните по номеру на его сайте. Проверьте недавние транзакции и сообщите о любых платежах, которые вы не распознаете."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتجميد البطاقة في تطبيق جهة الإصدار أو اتصل بالرقم الموجود على موقعها الإلكتروني. تحقق من المعاملات الأخيرة وأبلغ عن أي رسوم لا تعرفها."
          }
        }
      }
    },
    "emergency.medicine.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a pharmacy or clinic for help. Show the medicine name, prescription or a photo of the package. For urgent symptoms, call 119."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬局または医療機関へ相談し、薬の名前・処方箋・包装の写真を見せてください。症状が緊急なら119番へ電話します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向药店或医疗机构求助，并出示药名、处方或包装照片。症状紧急时拨打119。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向藥房或醫療機構求助，並出示藥名、處方或包裝照片。症狀緊急時撥打119。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약국이나 의료기관에 약 이름, 처방전 또는 포장 사진을 보여 주세요. 증상이 긴급하면 119에 전화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide ayuda en una farmacia o clínica y muestra el nombre, la receta o una foto del envase. Si es urgente, llama al 119."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez de l'aide à une pharmacie ou une clinique et montrez le nom, l'ordonnance ou une photo. En urgence, appelez le 119."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitten Sie eine Apotheke oder Klinik um Hilfe und zeigen Sie Name, Rezept oder Packungsfoto. Im Notfall 119 anrufen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอความช่วยเหลือจากร้านขายยาหรือคลินิก แสดงชื่อยา ใบสั่งยา หรือรูปบรรจุภัณฑ์ หากฉุกเฉินโทร 119"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mintalah bantuan apotek atau klinik. Tunjukkan nama obat, resep atau foto kemasannya. Untuk gejala mendesak, hubungi 119."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hỏi nhà thuốc hoặc phòng khám để được giúp đỡ. Hiển thị tên thuốc, đơn thuốc hoặc ảnh chụp bao bì. Đối với các triệu chứng khẩn cấp, hãy gọi 119."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça ajuda a uma farmácia ou clínica. Mostre o nome do medicamento, a receita ou uma foto da embalagem. Para sintomas urgentes, ligue para o 119."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi aiuto ad una farmacia o ad una clinica. Mostra il nome del medicinale, la prescrizione o una foto della confezione. Per sintomi urgenti chiamare il 119."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратитесь за помощью в аптеку или клинику. Покажите название лекарства, рецепт или фотографию упаковки. При неотложных симптомах звоните по номеру 119."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب المساعدة من صيدلية أو عيادة. أظهر اسم الدواء أو الوصفة الطبية أو صورة العبوة. للأعراض العاجلة اتصل على 119."
          }
        }
      }
    },
    "emergency.child.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell station staff or police immediately. Stay where the child was last seen, share a recent photo and describe their clothes. Call 110 if you cannot find them quickly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅員や警察へすぐ伝え、最後に見た場所で待ってください。最近の写真と服装を共有し、見つからない場合は110番へ電話します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即通知车站人员或警方，在最后见到孩子的地方等待，并提供近期照片和衣着特征。无法迅速找到时拨打110。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即通知車站人員或警方，在最後見到孩子的地方等候，並提供近期照片和衣著特徵。無法迅速找到時撥打110。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역무원이나 경찰에게 즉시 알리고 마지막으로 본 장소에서 기다리세요. 최근 사진과 옷차림을 알려 주고 찾지 못하면 110에 전화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa de inmediato al personal o a la policía. Espera donde lo viste por última vez, comparte una foto y describe su ropa. Llama al 110."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenez immédiatement le personnel ou la police. Restez au dernier lieu, partagez une photo et décrivez ses vêtements. Appelez le 110."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informieren Sie sofort Personal oder Polizei. Bleiben Sie am letzten Sichtungsort, zeigen Sie ein Foto und beschreiben Sie die Kleidung. Rufen Sie 110 an."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเจ้าหน้าที่หรือตำรวจทันที รอที่จุดที่เห็นเด็กครั้งสุดท้าย แสดงรูปล่าสุดและบอกเสื้อผ้า หากยังไม่พบโทร 110"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segera beri tahu staf stasiun atau polisi. Tetap di tempat anak terakhir kali terlihat, bagikan foto terbaru dan jelaskan pakaian mereka. Hubungi 110 jika Anda tidak dapat menemukannya dengan cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cho nhân viên nhà ga hoặc cảnh sát ngay lập tức. Ở lại nơi đứa trẻ được nhìn thấy lần cuối, chia sẻ một bức ảnh gần đây và mô tả quần áo của chúng. Hãy gọi 110 nếu bạn không thể tìm thấy họ nhanh chóng."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe imediatamente o pessoal da estação ou a polícia. Fique onde a criança foi vista pela última vez, compartilhe uma foto recente e descreva suas roupas. Ligue para o 110 se não conseguir encontrá-los rapidamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa immediatamente il personale della stazione o la polizia. Rimani dove il bambino è stato visto l'ultima volta, condividi una foto recente e descrivi i suoi vestiti. Chiama il 110 se non riesci a trovarli rapidamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немедленно сообщите об этом сотрудникам станции или полиции. Оставайтесь там, где ребенка видели в последний раз, поделитесь недавней фотографией и опишите его одежду. Позвоните по номеру 110, если не можете найти их быстро."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبر موظفي المحطة أو الشرطة على الفور. ابق حيث شوهد الطفل آخر مرة، وشارك صورة حديثة ووصف ملابسه. اتصل بالرقم 110 إذا لم تتمكن من العثور عليهم بسرعة."
          }
        }
      }
    },
    "emergency.theft.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to a safe place and call 110. Do not confront the person. Note the time, location and appearance, and preserve receipts, photos or messages as evidence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な場所へ移動して110番へ電話してください。相手を追わず、時刻・場所・特徴を記録し、レシートや写真などを保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往安全地点并拨打110。不要与对方冲突。记录时间、地点和外貌，并保存收据、照片或消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往安全地點並撥打110。不要與對方衝突。記錄時間、地點和外貌，並保存收據、照片或訊息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 곳으로 이동해 110에 전화하세요. 상대를 쫓지 말고 시간, 장소, 인상착의를 기록하며 증거를 보관하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a un lugar seguro y llama al 110. No te enfrentes a nadie. Anota hora, lugar y aspecto, y conserva pruebas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez-vous en sécurité et appelez le 110. Ne confrontez personne. Notez l'heure, le lieu et l'apparence, et gardez les preuves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie an einen sicheren Ort und rufen Sie 110. Konfrontieren Sie niemanden. Notieren Sie Zeit, Ort und Aussehen und sichern Sie Belege."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปยังที่ปลอดภัยและโทร 110 อย่าเผชิญหน้ากับผู้ต้องสงสัย จดเวลา สถานที่ ลักษณะ และเก็บหลักฐาน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindah ke tempat yang aman dan hubungi 110. Jangan berkonfrontasi dengan orang tersebut. Catat waktu, lokasi dan tampilannya, serta simpan kuitansi, foto atau pesan sebagai bukti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển đến nơi an toàn và gọi 110. Đừng đối đầu với người đó. Ghi lại thời gian, địa điểm và hình thức, đồng thời lưu giữ biên lai, ảnh hoặc tin nhắn làm bằng chứng."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá para um local seguro e ligue para o 110. Não confronte a pessoa. Anote a hora, o local e a aparência e guarde recibos, fotos ou mensagens como prova."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostarsi in un luogo sicuro e chiamare il 110. Non affrontare la persona. Annota l'ora, il luogo e l'aspetto e conserva ricevute, foto o messaggi come prova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в безопасное место и позвоните по номеру 110. Не вступайте в конфликт с человеком. Запишите время, место и внешний вид и сохраните квитанции, фотографии или сообщения в качестве доказательств."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى مكان آمن واتصل بالرقم 110. لا تواجه الشخص. سجل الوقت والمكان والمظهر، واحتفظ بالإيصالات أو الصور أو الرسائل كدليل."
          }
        }
      }
    },
    "emergency.departure.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell your airline and the airport information desk. Submit a police report before leaving Japan and keep the report number, contact details and online tracking links."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "航空会社と空港案内所へ相談してください。出国前に遺失届を出し、受理番号・連絡先・追跡ページを保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系航空公司和机场问讯处。离境前提交遗失申报，并保存受理编号、联系方式和查询链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聯絡航空公司和機場詢問處。離境前提交遺失申報，並保存受理編號、聯絡方式和查詢連結。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항공사와 공항 안내소에 문의하세요. 출국 전에 분실 신고를 하고 접수 번호, 연락처와 조회 링크를 보관하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con la aerolínea y el mostrador del aeropuerto. Denuncia la pérdida antes de salir y guarda el número, contactos y enlaces de seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contactez la compagnie et le comptoir de l'aéroport. Déclarez la perte avant de partir et gardez le numéro, les contacts et les liens de suivi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontaktieren Sie Fluggesellschaft und Flughafeninformation. Melden Sie den Verlust vor der Ausreise und speichern Sie Nummer, Kontakte und Tracking-Links."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดต่อสายการบินและประชาสัมพันธ์สนามบิน แจ้งของหายก่อนออกจากญี่ปุ่น และเก็บเลขรับเรื่อง ช่องทางติดต่อ และลิงก์ติดตาม"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beritahu maskapai penerbangan Anda dan meja informasi bandara. Kirimkan laporan polisi sebelum meninggalkan Jepang dan simpan nomor laporan, rincian kontak, dan tautan pelacakan online."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho hãng hàng không của bạn và bàn thông tin sân bay biết. Gửi báo cáo của cảnh sát trước khi rời Nhật Bản và giữ lại số báo cáo, chi tiết liên lạc và liên kết theo dõi trực tuyến."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a sua companhia aérea e o balcão de informações do aeroporto. Envie um boletim de ocorrência antes de sair do Japão e guarde o número do boletim de ocorrência, detalhes de contato e links de rastreamento on-line."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa la tua compagnia aerea e il banco informazioni dell'aeroporto. Invia una denuncia alla polizia prima di lasciare il Giappone e conserva il numero della denuncia, i dettagli di contatto e i link di tracciamento online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите об этом своей авиакомпании и в справочную службу аэропорта. Прежде чем покинуть Японию, подайте заявление в полицию и сохраните номер отчета, контактные данные и ссылки для отслеживания в Интернете."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبر شركة الطيران الخاصة بك ومكتب المعلومات بالمطار. أرسل بلاغًا للشرطة قبل مغادرة اليابان واحتفظ برقم التقرير وتفاصيل الاتصال وروابط التتبع عبر الإنترنت."
          }
        }
      }
    },
    "found.transport": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a train, bus or taxi: give it to staff or the driver"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電車・バス・タクシー内：係員または運転手へ渡す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电车、公交车或出租车内：交给工作人员或司机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在電車、巴士或的士內：交給工作人員或司機"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전철·버스·택시 안: 직원이나 기사에게 전달"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tren, autobús o taxi: entrégalo al personal o conductor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un train, bus ou taxi : remettez-le au personnel ou au conducteur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zug, Bus oder Taxi: Personal oder Fahrer übergeben"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนรถไฟ รถบัส หรือแท็กซี่: ส่งให้เจ้าหน้าที่หรือคนขับ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di kereta, bus, atau taksi: berikan kepada staf atau sopir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên tàu, xe buýt hoặc taxi: đưa cho nhân viên hoặc tài xế"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um trem, ônibus ou táxi: entregue ao funcionário ou ao motorista"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In treno, autobus o taxi: consegnarlo al personale o all'autista"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В поезде, автобусе или такси: отдайте его персоналу или водителю."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في القطار أو الحافلة أو سيارة الأجرة: أعطها للموظفين أو السائق"
          }
        }
      }
    },
    "found.facility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At a hotel, museum or airport: take it to the information desk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホテル・施設・空港内：受付または案内所へ渡す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在酒店、场馆或机场：交给前台或问讯处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在酒店、場館或機場：交給櫃檯或詢問處"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호텔·시설·공항: 안내 데스크에 전달"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un hotel, museo o aeropuerto: llévalo al mostrador de información"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un hôtel, musée ou aéroport : remettez-le à l'accueil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Hotel, Museum oder Flughafen: am Informationsschalter abgeben"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโรงแรม พิพิธภัณฑ์ หรือสนามบิน: ส่งให้ประชาสัมพันธ์"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di hotel, museum, atau bandara: bawa ke meja informasi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại khách sạn, bảo tàng hoặc sân bay: mang đến quầy thông tin"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Num hotel, museu ou aeroporto: leve-o ao balcão de informações"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un hotel, museo o aeroporto: portalo al banco informazioni"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отеле, музее или аэропорту: отнесите его на стойку информации."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في فندق أو متحف أو مطار: خذها إلى مكتب المعلومات"
          }
        }
      }
    },
    "found.cash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash: do not keep it; take it to a police box"
          }
        },
