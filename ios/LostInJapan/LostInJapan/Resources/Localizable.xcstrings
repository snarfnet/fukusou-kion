    "home.offlineNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery guides and Japanese cards work offline. Maps need a connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回収ガイドと日本語カードはオフラインでも使えます。地図には通信が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复指南和日语卡可以离线使用。地图需要连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復指南和日文卡可以離線使用。地圖需要連接。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 가이드 및 일본어 카드는 오프라인에서 작동합니다. 지도에는 연결이 필요합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las guías de recuperación y las tarjetas japonesas funcionan sin conexión. Los mapas necesitan una conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guides de récupération et les cartes japonaises fonctionnent hors ligne. Les cartes ont besoin d'une connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsanleitungen und japanische Karten funktionieren offline. Karten brauchen eine Verbindung."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่มือการกู้คืนและการ์ดภาษาญี่ปุ่นทำงานแบบออฟไลน์ แผนที่จำเป็นต้องมีการเชื่อมต่อ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan pemulihan dan kartu Jepang berfungsi offline. Peta memerlukan koneksi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn khôi phục và thẻ tiếng Nhật hoạt động ngoại tuyến. Bản đồ cần có kết nối."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guias de recuperação e cartões japoneses funcionam offline. Os mapas precisam de uma conexão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guide di recupero e le carte giapponesi funzionano offline. Le mappe necessitano di una connessione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Руководства по восстановлению и японские карты работают в автономном режиме. Картам нужна связь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل أدلة الاسترداد والبطاقات اليابانية دون اتصال بالإنترنت. الخرائط تحتاج إلى اتصال."
          }
        }
      }
    },
