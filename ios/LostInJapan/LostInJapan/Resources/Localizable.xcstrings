    "home.helpNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you need now?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今、必要なこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在需要什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在需要什麼？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 무엇이 필요합니까?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué necesitas ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De quoi as-tu besoin maintenant ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was brauchen Sie jetzt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องการอะไรตอนนี้?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang kamu butuhkan sekarang?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ bạn cần gì?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você precisa agora?"
          }
