    "police.permissionDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location in Settings, or search for ‘交番’ in Apple Maps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中允许定位，或在 Apple 地图中搜索“交番”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中允許定位，或在 Apple 地圖中搜尋「交番」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 위치를 허용하거나 Apple 지도에서 '交番'을 검색하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita la ubicación en Configuración o busque \"交番\" en Apple Maps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la localisation dans Paramètres ou recherchez « 交番 » dans Apple Maps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Standort in den Einstellungen oder suchen Sie in Apple Maps nach „交番“."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตตำแหน่งในการตั้งค่า หรือค้นหาคำว่า '交番' ใน Apple Maps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で位置情報を許可するか、Apple マップで「交番」を検索してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan lokasi di Pengaturan, atau cari ‘交番’ di Apple Maps."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép vị trí trong Cài đặt hoặc tìm kiếm ‘交番’ trong Apple Maps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a localização em Configurações ou pesquise ‘交番’ no Apple Maps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti la posizione nelle Impostazioni o cerca \"交番\" in Apple Maps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите местоположение в настройках или найдите «交番» в Apple Maps."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالموقع في الإعدادات، أو ابحث عن \"交番\" في خرائط Apple."
          }
        }
      }
    },
