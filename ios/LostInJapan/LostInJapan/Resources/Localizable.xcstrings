    "plan.askStation.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your route, time, car, and seat if known."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示您的路线、时间、车辆和座位（如果已知）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示您的路線、時間、車輛和座位（如果已知）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로, 시간, 차량, 좌석을 알고 있는 경우 표시하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu ruta, hora, coche y asiento si lo conoces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez votre itinéraire, votre heure, votre voiture et votre siège si vous les connaissez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie Ihre Route, Zeit, Ihr Auto und Ihren Sitzplatz an, sofern bekannt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
