    "plan.embassy.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A missing passport may prevent departure. Check current official guidance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "护照丢失可能会导致无法出境。检查当前的官方指导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "護照遺失可能會導致無法出境。檢查當前的官方指導。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여권이 분실되면 출국이 불가능할 수 있습니다. 현재 공식 지침을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La falta del pasaporte puede impedir la salida. Consulte la orientación oficial actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passeport manquant peut empêcher le départ. Consultez les directives officielles actuelles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein fehlender Reisepass kann die Ausreise verhindern. Überprüfen Sie die aktuellen offiziellen Leitlinien."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนังสือเดินทางที่หายไปอาจทำให้ไม่สามารถออกเดินทางได้ ตรวจสอบคำแนะนำอย่างเป็นทางการในปัจจุบัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスポートがないと出国できない場合があります。大使館や領事館の最新情報を確認してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paspor yang hilang dapat menghalangi keberangkatan. Periksa panduan resmi saat ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hộ chiếu bị mất có thể cản trở việc khởi hành. Kiểm tra hướng dẫn chính thức hiện tại."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A falta do passaporte pode impedir a partida. Verifique as orientações oficiais atuais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mancanza del passaporto può impedire la partenza. Controlla le attuali linee guida ufficiali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсутствие паспорта может помешать выезду. Проверьте текущее официальное руководство."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جواز السفر المفقود قد يمنع المغادرة. تحقق من التوجيهات الرسمية الحالية."
          }
        }
      }
    },
