    "settings.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app cannot guarantee recovery. Follow current official guidance from police, transport operators, embassies, and card issuers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用程序不能保证恢复。遵循警方、交通运营商、大使馆和发卡机构的最新官方指导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式不能保證恢復。遵循警方、交通運輸業者、大使館和發卡機構的最新官方指示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 복구를 보장할 수 없습니다. 경찰, 운송업체, 대사관, 카드 발급기관의 최신 공식 지침을 따르세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aplicación no puede garantizar la recuperación. Siga las directrices oficiales actuales de la policía, los operadores de transporte, las embajadas y los emisores de tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application ne peut pas garantir la récupération. Suivez les directives officielles actuelles de la police, des opérateurs de transport, des ambassades et des émetteurs de cartes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App kann keine Wiederherstellung garantieren. Befolgen Sie die aktuellen offiziellen Richtlinien von Polizei, Transportunternehmen, Botschaften und Kartenherausgebern."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้ไม่สามารถรับประกันการกู้คืนได้ ปฏิบัติตามคำแนะนำอย่างเป็นทางการในปัจจุบันจากตำรวจ ผู้ประกอบการขนส่ง สถานทูต และผู้ออกบัตร"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは落とし物の回収を保証しません。警察、交通機関、大使館、カード会社の公式案内を優先してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini tidak dapat menjamin pemulihan. Ikuti panduan resmi terkini dari polisi, operator transportasi, kedutaan, dan penerbit kartu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này không thể đảm bảo phục hồi. Tuân theo hướng dẫn chính thức hiện hành của cảnh sát, nhà điều hành vận tải, đại sứ quán và tổ chức phát hành thẻ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aplicativo não pode garantir a recuperação. Siga as orientações oficiais atuais da polícia, operadores de transporte, embaixadas e emissores de cartões."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non può garantire il ripristino. Segui le linee guida ufficiali attuali della polizia, degli operatori dei trasporti, delle ambasciate e degli emittenti delle carte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение не может гарантировать восстановление. Следуйте текущим официальным рекомендациям полиции, транспортных операторов, посольств и эмитентов карт."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا التطبيق ضمان الاسترداد. اتبع الإرشادات الرسمية الحالية من الشرطة ومشغلي النقل والسفارات وجهات إصدار البطاقات."
          }
        }
      }
    },
