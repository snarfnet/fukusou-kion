          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかっている場合は、ルート、時間、車両、座席を表示します。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan rute, waktu, mobil, dan tempat duduk Anda jika diketahui."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị lộ trình, thời gian, xe và chỗ ngồi của bạn nếu biết."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre sua rota, horário, carro e assento, se conhecido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il percorso, l'orario, l'auto e il posto, se noto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите свой маршрут, время, автомобиль и место, если оно известно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر طريقك ووقتك وسيارتك ومقعدك إذا كان معروفًا."
          }
        }
      }
    },
