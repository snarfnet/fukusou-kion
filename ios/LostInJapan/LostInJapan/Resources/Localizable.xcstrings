    "settings.noCardNumbers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never enter a full card number, PIN, or password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿输入完整的卡号、PIN 码或密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿輸入完整的卡號、PIN 碼或密碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 카드 번호, PIN 또는 비밀번호를 입력하지 마십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca ingrese un número de tarjeta completo, PIN o contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne saisissez jamais un numéro de carte complet, un code PIN ou un mot de passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie niemals eine vollständige Kartennummer, PIN oder ein Passwort ein."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าป้อนหมายเลขบัตร PIN หรือรหัสผ่านให้ครบถ้วน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード番号、PIN、パスワードを完全に入力しないでください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah memasukkan nomor kartu, PIN, atau kata sandi lengkap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao giờ nhập số thẻ, mã PIN hoặc mật khẩu đầy đủ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca insira um número completo de cartão, PIN ou senha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non inserire mai il numero completo della carta, il PIN o la password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не вводите полный номер карты, PIN-код или пароль."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقم مطلقًا بإدخال رقم البطاقة بالكامل أو رقم التعريف الشخصي أو كلمة المرور."
          }
        }
      }
    },
